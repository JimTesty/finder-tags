#compdef tag

_arguments \
  '(-l --list)'{-l,--list}'[list tags]' \
  '--export[export JSONL archive]:root:_files' \
  '--restore[restore archive]:archive:_files' \
  '--convert[convert JSONL archive to text]:archive:_files' \
  '(-a --add)'{-a,--add}'[add tags]:tags:' \
  '--append[add tags at end]:tags:' \
  '--prepend[add tags at beginning]:tags:' \
  '(-r --remove)'{-r,--remove}'[remove tags]:tags:' \
  '(-s --set)'{-s,--set}'[replace tags]:tags:' \
  '--copy[copy ordered tags]:source:_files:destination:_files' \
  '(-m --match)'{-m,--match}'[match tags]:tags:' \
  '--filter[match tags with list-style output]:tags:' \
  '(-u --usage)'{-u,--usage}'[count usage]:tags:' \
  '(-f --find)'{-f,--find}'[Spotlight find]:tags:' \
  '--move[move tag]:tag::position:' \
  '--at[insertion position]:position:' \
  '--before[place before tag]:tag:' \
  '--after[place after tag]:tag:' \
  '--sorted-tags[sort tag output/final mutations]' \
  '--sort-tags[alias for --sorted-tags]' \
  '(-V --reverse)'{-V,--reverse}'[reverse display order]' \
  '(-C --case-sensitive)'{-C,--case-sensitive}'[case-sensitive matching]' \
  '(-c --color)'{-c,--color}'[color tags]' \
  '--tagged-only[list/export only tagged items]' \
  '(-n --filename)'{-n,--filename}'[show filenames]' \
  '(-N --no-filename)'{-N,--no-filename}'[hide filenames]' \
  '(-t --tags)'{-t,--tags}'[show tags]' \
  '(-T --no-tags)'{-T,--no-tags}'[hide tags]' \
  '(-g --one-per-line)'{-g,--one-per-line}'[one tag per line]' \
  '(-G --comma-separated)'{-G,--comma-separated}'[comma-separated tags]' \
  '--space-indent[use two spaces before tags]' \
  '--align-tags[pad file paths before tags]:width:' \
  '--compact-tags[mimic Finder mini color-circles]' \
  '(-p --slash)'{-p,--slash}'[append slash to directories]' \
  '(-0 --null)'{-0,--null}'[NUL-terminate records]' \
  '--absolute[absolute paths]' \
  '--file-info[include file size and mtime]' \
  '--no-file-info[omit export file information]' \
  '--jsonl[JSON Lines output]' \
  '--ndjson[alias for --jsonl]' \
  '--stdin[read newline-delimited paths]' \
  '--stdin0[read NUL-delimited paths]' \
  '(-A --all)'{-A,--all}'[include hidden files]' \
  '(-e --enter)'{-e,--enter}'[enter directories]' \
  '(-R -d --recursive)'{-R,-d,--recursive}'[recursive]' \
  '--no-follow-symlinks[do not follow symlinks (default)]' \
  '{-L,--follow-symlinks}[follow symlinks and symlinked directories]' \
  '--exclude[exclude path/subtree during traversal]:path:_files' \
  '--print-symlinks[print symlink destinations]' \
  '--dry-run[preview mutations]' \
  '--root[relocate restore root]:directory:_files' \
  '--backup[write undo archive]:archive:_files' \
  '--no-backup[disable undo archive]' \
  '--sync-backup[sync each undo record]' \
  '(-h --help)'{-h,--help}'[help]' \
  '(-v --verbose)'{-v,--verbose}'[show informational messages]' \
  '--version[version]' \
  '*:path:_files'
